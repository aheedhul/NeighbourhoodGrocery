# Copy this file to .env and fill in the values before running the server

# MySQL connection string (required)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/neighbourhood_grocery"

# JWT signing secret — use a long random string in production
JWT_SECRET="replace_me_with_a_long_random_secret"

# Server port (default: 4000)
PORT=4000

# Comma-separated list of allowed CORS origins (default: http://localhost:5173)
ALLOWED_ORIGINS="http://localhost:5173"
